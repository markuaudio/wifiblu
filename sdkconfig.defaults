CONFIG_IDF_TARGET="esp32"
# Release version printed at boot (app_init: App version) and stored in the
# binary's app descriptor; bump it for every client release.
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.0"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Classic Bluetooth only (BLE memory released at boot).
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y

# Music: A2DP sink + AVRCP (play/pause, next, absolute volume).
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_AVRCP_ENABLED=y
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=n

# Calls: HFP Hands-Free unit. Voice (SCO) travels over HCI so the firmware
# gets PCM (CVSD 8 kHz / mSBC 16 kHz) and plays it through the ES8388.
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y
CONFIG_BT_HFP_AG_ENABLE=n
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y
CONFIG_BT_HFP_USE_EXTERNAL_CODEC=n
CONFIG_BT_HFP_WBS_ENABLE=y
CONFIG_BTDM_CTRL_BR_EDR_SCO_DATA_PATH_HCI=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Wi-Fi + Classic Bluetooth share the one ESP32 radio: software coexistence on.
# Expect A2DP audio to suffer while Wi-Fi is busy; plan Wi-Fi use for setup/OTA
# or short transfers, not continuous streaming next to music.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# ESP-IDF's brownout handler is OFF: it would reset the chip. main/power_guard.c
# programs the same brownout comparator itself (level 7 = 2.80 V, above the
# LyraT's IMP809 supervisor at 2.63 V) and its interrupt cuts the amplifier
# instead of resetting, so a weak supply costs a short mute, not the link.
CONFIG_ESP_BROWNOUT_DET=n

# Release build (final project). -O2 instead of the IDF default -Og: the audio
# task does float limiter / gain maths per sample at 44.1 kHz on core 1.
# Assertions stay on while hardware bring-up of the call path is unfinished.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# AVRCP cover art (BIP over OBEX) is never used by a speaker: saves RAM/flash.
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=n

# ---- Wi-Fi (Phase 1: setup portal, wifiblu.local control page, OTA) ----
# Two OTA slots (partitions.csv). A freshly updated image must prove itself
# (esp_ota_mark_app_valid_cancel_rollback in main.c once Bluetooth is ready);
# otherwise the bootloader returns to the previous image on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Captive portal: phones open several connections while probing; mDNS and the
# DNS redirector need sockets too.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
# Wi-Fi RAM: smaller buffers than the default, the Bluetooth stack already
# holds a lot of the internal heap. 6/8 buffers are enough for a settings page
# and a firmware upload; music streaming never runs over Wi-Fi in Phase 1.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
